# Copy this file to .env and set only the variables you actually need.
# You can keep multiple AtlasCloud flows in one file without committing secrets.
ATLASCLOUD_API_KEY=your_atlascloud_api_key_here
ATLASCLOUD_API_URL=https://api.atlascloud.ai/api/v1/model/generateImage

# Scratch image generation
# ATLASCLOUD_SCRATCH_MODEL=bytedance/seedream-v5.0-pro/text-to-image
# ATLASCLOUD_INSTRUCTIONS_DIR=./instructions/create-images-for-journalist-characters
# ATLASCLOUD_SCRATCH_OUTPUT_DIR=./results/scratch_prompts

# Reference-image generation
# ATLASCLOUD_REF_MODEL=bytedance/seedream-v5.0-pro/generate
# ATLASCLOUD_OUTPUT_DIR=./results/reference_prompts

# Sequential image edit flow
# ATLASCLOUD_EDIT_MODEL=bytedance/seedream-v5.0-pro/edit
# ATLASCLOUD_EDIT_PROMPT=Swap the colors at position 1 and position 2; use the color from position 1 as the primary body color and the color from position 2 as the accent color.
# ATLASCLOUD_EDIT_IMAGE_FOLDER=C:/path/to/reference/images
# ATLASCLOUD_EDIT_SAVE_FOLDER=C:/path/to/output/images
