# Copy this file to .env and add your AtlasCloud API key
ATLASCLOUD_API_KEY=your_atlascloud_api_key_here
# Optional: override the default API endpoint
# ATLASCLOUD_API_URL=https://api.atlascloud.ai/api/v1/model/generateImage
# Optional: set the edit model
# ATLASCLOUD_EDIT_MODEL=bytedance/seedream-v5.0-pro/edit
# Required: set the prompt for editing
# ATLASCLOUD_EDIT_PROMPT=Swap the colors at position 1 and position 2; use the color from position 1 as the primary body color and the color from position 2 as the accent color.
# Required: set one or more image URLs or local paths, comma-separated
# ATLASCLOUD_EDIT_IMAGES=https://static.atlascloud.ai/media/images/295d0bff040e66b4cd3f9835cd93a820.png
# Optional: save the edited image to this folder
# ATLASCLOUD_EDIT_SAVE_FOLDER=edited_images
